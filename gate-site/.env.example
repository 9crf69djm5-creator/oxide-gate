# Copy to .env.local for local overrides (optional).
# After deploying gate-api, set the hosted URL:

VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_DISCORD_INVITE=https://discord.gg/3PXJ8r56T
VITE_DISCORD_BOT_HEALTH_URL=https://oxide-discord-bot-fra.onrender.com/

# Production example (fill after Render deploy):
# VITE_API_BASE_URL=https://YOUR-SERVICE.onrender.com

# Help assistant (api/chat.js) — SERVER-ONLY. Set in Vercel project env, never with a VITE_ prefix.
# Works with no keys: free no-key providers are tried in order (ch.at gpt-4o-mini, LLM7.io,
# Pollinations). Any key set below is tried first.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# LLM7_API_KEY=        (optional free token from llm7.io for higher limits)
# OXIDE_CHAT_MODEL=
