PORT=8787
ADMIN_SECRET=change-me-to-a-long-random-string
DOWNLOAD_URL=https://oxide-gate-site.vercel.app/downloads/Oxide.exe
# Comma-separated origins allowed by CORS (gate site)
# After Vercel deploy, include https://your-app.vercel.app
CORS_ORIGINS=https://oxide-gate-site.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,null
DISCORD_INVITE=https://discord.gg/3PXJ8r56T
# On Render free tier with disk mounted at /data:
# DB_PATH=/data/keys.db
# DB_PATH=./data/keys.db

# —— Roblox payments (Game Pass preferred; Shirt / T-Shirt still supported) ——
# Game pass buy URL: https://www.roblox.com/game-pass/ID
# Shirt catalog URL:  https://www.roblox.com/catalog/ASSETID
# Prefer gamepass env vars when set — they win over shirt asset IDs for the same plan.
ROBLOX_GAMEPASS_WEEK=1999442394
ROBLOX_GAMEPASS_MONTH=1999370393
ROBLOX_GAMEPASS_LIFETIME=1999478401
# Shirt / asset fallbacks (used only if the matching GAMEPASS_* var is empty).
# Leave blank when using game passes so they do not override:
ROBLOX_ASSET_WEEK=
ROBLOX_ASSET_MONTH=
# Optional premium shirt
# ROBLOX_ASSET_PREMIUM=
# Do NOT set ROBLOX_PRODUCT_MAP in production — it overrides GAMEPASS_* and can
# collapse week/month onto the lifetime pass. Delete it on Render if present.
# ROBLOX_PRODUCT_MAP=
# Alias: ROBLOX_ASSET_IDS (same JSON shape)

# Optional .ROBLOSECURITY cookie if public inventory checks start failing (401/403).
# Prefer an alt account. Never commit a real cookie.
# ROBLOX_COOKIE=

# Skip ownership checks for local testing (never enable in real production sales).
DEMO_ROBLOX=0
