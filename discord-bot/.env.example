# Discord application (https://discord.com/developers/applications)
# Paste these once in Render → oxide-discord-bot-fra → Environment (bot runs 24/7 in cloud).
DISCORD_TOKEN=
CLIENT_ID=1553058568872394832
GUILD_ID=

# REQUIRED for /key-create — MUST match Render oxide-gate-api → ADMIN_SECRET
# (Blueprint generateValue). Local oxide-dev-admin-secret will NOT work against production.
# Copy from: Render dashboard → oxide-gate-api → Environment → ADMIN_SECRET
# (or %TEMP%\oxide_admin_secret.txt if you saved it during deploy).
ADMIN_SECRET=

# Gate API + site (cloud defaults — do not point at localhost in production)
API_BASE_URL=https://oxide-gate-api.onrender.com
SITE_URL=https://oxide-gate-site.vercel.app
DISCORD_INVITE=https://discord.gg/3PXJ8r56T

# Roblox version poll interval in minutes (15–30 recommended)
ROBLOX_POLL_MINUTES=20

# Auto-run /setup on ready when INFO category is missing (true/false)
AUTO_SETUP=true

# Welcome new joins in #announcements (true/false)
WELCOME_MESSAGE=true

# Oxide release announcements (default channel: #updates)
# UPDATES_CHANNEL_ID=   # optional: post releases in this channel instead
# UPDATES_PING=         # optional: e.g. @everyone or <@&ROLE_ID>
RELEASE_POLL_MINUTES=5
RELEASE_ANNOUNCE=true

# OXIDE AI help: answers in #help and in DMs (/ask). Free providers, no key needed.
# Needs the Message Content intent on the bot (Developer Portal → Bot).
AI_HELP=true
# HELP_CHANNEL_ID=      # optional: answer in this channel instead of #help
# OPENAI_API_KEY= / GROQ_API_KEY= / GEMINI_API_KEY= / LLM7_API_KEY=   # optional, tried first
